# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose maps it to 5433). Admin user is a superuser: seeding/migrations only.
DATABASE_URL=postgresql+psycopg://shiftpilot:shiftpilot@localhost:5433/shiftpilot
# Runtime role created by `python -m db.init`; RLS applies to it.
APP_DATABASE_URL=postgresql+psycopg://shiftpilot_app:shiftpilot_app@localhost:5433/shiftpilot
APP_DB_PASSWORD=shiftpilot_app
# Optimization worker: least-privilege role from migration 0015 (cross-tenant, runs/candidates/outbox only).
WORKER_DATABASE_URL=postgresql+psycopg://shiftpilot_worker:shiftpilot_worker@localhost:5433/shiftpilot
WORKER_DB_PASSWORD=shiftpilot_worker
# Outbox relay (python -m jobs.outbox_relay): least-privilege role from migration 0016.
RELAY_DATABASE_URL=postgresql+psycopg://shiftpilot_relay:shiftpilot_relay@localhost:5433/shiftpilot
RELAY_DB_PASSWORD=shiftpilot_relay
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=generate-a-long-random-string

# LLM providers (LiteLLM reads these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model routing (LiteLLM model strings; change freely)
ROUTER_MODEL=anthropic/claude-haiku-5-5
MAIN_MODEL=anthropic/claude-sonnet-5-5
FALLBACK_MODEL=gemini/gemini-2.5-flash
JUDGE_MODEL=openai/gpt-4.1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# stdio MCP (Claude Desktop) acts as this user. +919800000002 = Brew Lane Café manager.
MCP_DEMO_USER_PHONE=+919800000002

# Channels (M5)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
